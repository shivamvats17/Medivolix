# ==============================================================================
# Medivolix Environment Configuration Template
# Copy this file to .env before starting containers: cp .env.example .env
# ==============================================================================

# Database Settings
DB_NAME=medivolix_db
DB_USER=medivolix_user
DB_PASSWORD=medivolix_pass
DB_ROOT_PASSWORD=rootpassword
DB_PORT=3306

# Frontend Port
FRONTEND_PORT=80

# Application Configuration
APP_STOCK_FRESHNESS_HOURS=24
APP_LOW_STOCK_THRESHOLD=10
APP_EXPIRY_WARNING_DAYS=45
