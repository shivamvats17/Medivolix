# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.java text diff=java eol=lf
*.html text diff=html eol=lf
*.css text diff=css eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Shell and Windows scripts
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.war binary
*.jar binary
