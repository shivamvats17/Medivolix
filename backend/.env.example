# Medivolix Backend Environment Variables Example
# Copy this file to .env and adjust values for your environment.

PORT=8080
DB_URL=jdbc:mysql://localhost:3306/medivolix_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=your_mysql_password_here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STOCK_FRESHNESS_HOURS=24
LOW_STOCK_THRESHOLD=10
EXPIRY_WARNING_DAYS=45
