<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Medivolix Backend API</display-name>

    <session-config>
        <session-timeout>120</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Application Lifecycle Listener -->
    <listener>
        <listener-class>com.medivolix.listener.AppContextListener</listener-class>
    </listener>

    <!-- CORS Filter -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.medivolix.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.medivolix.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.medivolix.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MedicineServlet</servlet-name>
        <servlet-class>com.medivolix.controller.MedicineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicineServlet</servlet-name>
        <url-pattern>/api/medicines/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PharmacyServlet</servlet-name>
        <servlet-class>com.medivolix.controller.PharmacyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PharmacyServlet</servlet-name>
        <url-pattern>/api/pharmacies/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AvailabilityRequestServlet</servlet-name>
        <servlet-class>com.medivolix.controller.AvailabilityRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvailabilityRequestServlet</servlet-name>
        <url-pattern>/api/availability-requests/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PharmacyInventoryServlet</servlet-name>
        <servlet-class>com.medivolix.controller.PharmacyInventoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PharmacyInventoryServlet</servlet-name>
        <url-pattern>/api/pharmacy/inventory/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PharmacyRequestServlet</servlet-name>
        <servlet-class>com.medivolix.controller.PharmacyRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PharmacyRequestServlet</servlet-name>
        <url-pattern>/api/pharmacy/requests/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.medivolix.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

</web-app>
